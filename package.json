{
  "name": "Sonara",
  "desktopName": "sonara.desktop",
  "version": "0.1.0",
  "description": "Modern YouTube Music Desktop Player",
  "author": "Sonara Developers <contact@dannieldev.dev>",
  "main": "dist-electron/main.js",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "build:renderer": "ng build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:all": "npm run build:renderer && npm run build:electron",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "package": "pnpm build:all && electron-builder --dir",
    "dist": "pnpm build:all && electron-builder",
    "dist:mac": "pnpm build:all && electron-builder --mac",
    "dist:win": "pnpm build:all && electron-builder --win",
    "dist:linux": "pnpm build:all && electron-builder --linux",
    "ng:serve": "ng serve",
    "electron:build-ts": "tsc -p tsconfig.electron.json",
    "electron:start": "npm run electron:build-ts && wait-on http://localhost:4200 && electron .",
    "dev": "concurrently \"npm run ng:serve\" \"npm run electron:start\""
  },
  "private": true,
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@lucide/angular": "^1.40.0",
    "@soarlin/angular-color-thief": "^2.0.4",
    "jwt-decode": "^4.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "wavesurfer.js": "^7.12.11"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "@tailwindcss/postcss": "^4.1.12",
    "concurrently": "^10.0.5",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "dev.dannieldev.sonara",
    "productName": "Sonara",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/ytmdannieldev/browser/**/*",
      "icons/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "icons/macos/icon.icns",
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "icon": "icons/windows/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sonara"
    },
    "linux": {
      "syncDesktopName": true,
      "icon": "icons/linux/icons/512x512.png",
      "category": "AudioVideo;Audio;Player;",
      "maintainer": "Sonara Developers <contact@dannieldev.dev>",
      "synopsis": "Modern YouTube Music Desktop Player",
      "description": "Sonara is a sleek, modern desktop YouTube Music player built with Angular and Electron.",
      "target": [
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
